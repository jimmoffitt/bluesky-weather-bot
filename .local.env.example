# bluesky_weather_bot configuration
# Copy to .local.env and fill in your values.
# .local.env is gitignored — never commit it.

# --- Bluesky credentials ---
BSKY_HANDLE=yourhandle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Storage ---
DB_PATH=data/zipwx.db

# --- File alert channel (inbox watcher) ---
INBOX_PATH=inbox
INBOX_ARCHIVE_PATH=inbox/archive
INBOX_ERROR_PATH=inbox/errors
INBOX_POLL_INTERVAL_SEC=5.0

# --- Logging ---
LOG_PATH=logs/zipwx.log
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- Weather ---
WEATHER_CACHE_TTL_MINUTES=30
# Set to true during development to skip archive API calls (much faster)
SKIP_HISTORICAL=false

# --- Post mode ---
# POST_MODE=text   (default) — 3-post text thread
# POST_MODE=image            — single post with 2 embedded PNGs (needs Pillow)
POST_MODE=text

# --- Server identification (shown in latency footer) ---
# SERVER_TYPE=laptop   (default)
# SERVER_TYPE=Pi
SERVER_TYPE=laptop

# --- Public-mention backend(s) — comma-delimited ---
# MENTION_BACKEND=firehose             (default) — raw AT Protocol firehose
# MENTION_BACKEND=jetstream                      — Jetstream (lighter; see README)
# MENTION_BACKEND=firehose,jetstream             — run both (dedup is automatic)
MENTION_BACKEND=firehose
